{
  "name": "vincentvdree/bedrock-docker-setup",
  "type": "project",
  "license": "MIT",
  "description": "Bedrock Docker Setup",
  "authors": [
    {
      "name": "Vincent van der Ree",
      "email": "vincentvanderree@proton.me",
      "homepage": "https://github.com/vincentvdree"
    }
  ],
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-mysqli": "*",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.0.*",
    "roots/wp-config": "^1.0",
    "vincentvdree/wp-hooked": "^2.0",
    "vlucas/phpdotenv": "^5.0",
    "wp-plugin/redis-cache": "^2.8",
    "wp-theme/twentytwentyfive": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "symfony/var-dumper": "^8.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-plugin/query-monitor": "^4.0",
    "wp-plugin/simply-show-hooks": "^1.3",
    "wp-plugin/wp-crontrol": "^1.21"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "phpstan/extension-installer": true,
      "roots/wordpress-core-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  }
}
